# 复制为 .env 并填入真实值。未配置飞书时系统仍可用 URL 参数身份访问。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书后台「安全设置-重定向URL」里登记的同一个地址，必须完全一致
FEISHU_REDIRECT_URI=https://你的公网地址/oauth/callback
FEISHU_SCOPE=contact:user.base:readonly

# 超级管理员 open_id（根权限，逗号分隔）。其余管理员由超管在后台勾选，存数据库。
FEISHU_SUPERADMIN_OPEN_IDS=

# 会话 cookie 签名密钥，填一串长随机字符
SESSION_SECRET=

# 生产安全配置。正式 HTTPS 部署保持 true；本地 HTTP 调试可临时设 false。
COOKIE_SECURE=true
HSTS_ENABLED=true
REQUIRE_LOGIN_FOR_CLAIM=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_SEARCH=60
RATE_LIMIT_LOGIN=20
RATE_LIMIT_IMPORT=10
RATE_LIMIT_EXPORT=20

# OCR：none / tencent。腾讯云 OCR 用于识别图片型银行回单 PDF。
OCR_PROVIDER=none
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
